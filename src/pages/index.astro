---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CircuitLine from '../components/CircuitLine.astro';
import ServicesPanel from '../components/ServicesPanel.astro';
import Gallery from '../components/Gallery.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

const numberFromPath = (path: string) => Number(path.match(/(\d+)\.jpeg$/)?.[1] ?? 0);

const lucesModules = import.meta.glob('../assets/gallery/luces/*.jpeg', { eager: true, import: 'default' });
const lucesImages = Object.entries(lucesModules)
  .sort(([a], [b]) => numberFromPath(a) - numberFromPath(b))
  .map(([, mod]) => mod) as ImageMetadata[];

const reformaModules = import.meta.glob('../assets/gallery/reformas/*.jpeg', { eager: true, import: 'default' });
const reformaImages = Object.entries(reformaModules)
  .sort(([a], [b]) => numberFromPath(a) - numberFromPath(b))
  .map(([, mod]) => mod) as ImageMetadata[];
---

<BaseLayout
  title="DaniManitas — Manitas de confianza en Madrid"
  description="Reparaciones, instalación de iluminación y reformas en Madrid. Contacta por WhatsApp, teléfono o email."
>
  <CircuitLine />
  <Header />

  <main>
    <Hero />
    <ServicesPanel />

    <Gallery
      id="iluminacion"
      eyebrow="Portfolio"
      title="Iluminación"
      lede="Instalaciones y diseño de iluminación interior y exterior."
      images={lucesImages}
      altPrefix="Instalación de iluminación en Madrid"
      variant="spotlight"
      dark
    />

    <Gallery
      id="reformas"
      title="Reformas"
      lede="Transformaciones completas con acabados de calidad."
      images={reformaImages}
      altPrefix="Reforma de vivienda en Madrid"
      variant="pan"
    />

    <ProcessSteps />
    <Contact />
  </main>

  <Footer />

  <a href="https://wa.me/34627014153" target="_blank" rel="noopener" class="float-whatsapp" aria-label="Escribir por WhatsApp">
    <i class="fab fa-whatsapp"></i>
  </a>

  <Lightbox />

  <script>
    import '../scripts/motion.js';
  </script>
</BaseLayout>
