---
import { Image } from 'astro:assets';
import heroBg from '../assets/brand/hero-bg.png';

const breakers = [
  { label: 'Reparaciones' },
  { label: 'Iluminación' },
  { label: 'Reformas' },
];
---

<section id="hero">
  <div class="hero-media">
    <Image src={heroBg} alt="" class="hero-bg" widths={[640, 1024, 1600, 2000]} sizes="100vw" quality={80} />
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero-content">
    <div class="breaker-panel" aria-hidden="true">
      {breakers.map((b) => (
        <div class="breaker">
          <span class="breaker-track">
            <span class="breaker-nub"></span>
          </span>
          <span class="breaker-label">{b.label}</span>
        </div>
      ))}
    </div>

    <h1>Tu manitas de confianza<br />en Madrid.</h1>
    <p class="hero-lede">Reparaciones, instalaciones y reformas con acabados de calidad, a domicilio.</p>
    <div class="cta-group">
      <a href="#contact" class="btn btn-primary" data-magnetic>Contactar</a>
      <a href="#iluminacion" class="btn btn-secondary" data-magnetic>Ver trabajos</a>
    </div>
  </div>
</section>

<style>
  #hero {
    height: 100vh;
    min-height: 640px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--on-dark);
    padding-top: 76px;
    overflow: hidden;
    background: var(--graphite);
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0) brightness(0.62) contrast(1.05);
    transition: filter 1.1s var(--ease-out);
    transition-delay: 0.85s;
  }

  :global(html.js:not(.no-motion)) #hero:not(.is-powered) .hero-media .hero-bg {
    filter: grayscale(1) brightness(0.32) contrast(1.05);
    transition-delay: 0s;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, var(--signal-line) 0 1px, transparent 1px 46px),
      repeating-linear-gradient(90deg, var(--signal-line) 0 1px, transparent 1px 46px);
    opacity: 0.07;
    mix-blend-mode: screen;
    transition: opacity 1s var(--ease-out);
    transition-delay: 0.85s;
  }

  :global(html.js:not(.no-motion)) #hero:not(.is-powered) .hero-grid {
    opacity: 0.55;
    transition-delay: 0s;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 10%, rgba(255, 176, 21, 0.12), transparent 60%),
      linear-gradient(180deg, rgba(18, 21, 26, 0.55), rgba(18, 21, 26, 0.75));
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  /* Breaker panel */
  .breaker-panel {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin-bottom: 30px;
  }

  .breaker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .breaker-track {
    width: 28px;
    height: 50px;
    border-radius: 6px;
    background: rgba(242, 244, 245, 0.07);
    border: 1px solid rgba(242, 244, 245, 0.16);
    display: flex;
    align-items: flex-end;
    padding: 3px;
  }

  .breaker-nub {
    display: block;
    width: 100%;
    height: 20px;
    border-radius: 4px;
    background: var(--signal);
    box-shadow: 0 0 14px 1px var(--signal-line);
    transition: transform 0.55s var(--ease-spring), background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .breaker-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-on-dark);
  }

  :global(html.js:not(.no-motion)) #hero:not(.is-powered) .breaker-nub {
    transform: translateY(24px);
    background: var(--muted-on-dark);
    box-shadow: none;
    transition-delay: 0s;
  }

  #hero.is-powered .breaker:nth-child(1) .breaker-nub {
    transition-delay: 0.1s;
  }

  #hero.is-powered .breaker:nth-child(2) .breaker-nub {
    transition-delay: 0.32s;
  }

  #hero.is-powered .breaker:nth-child(3) .breaker-nub {
    transition-delay: 0.54s;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    transition-delay: 0.95s;
  }

  .hero-lede {
    font-size: 1.15rem;
    margin-bottom: 36px;
    color: var(--muted-on-dark);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    transition-delay: 1.05s;
  }

  .cta-group {
    display: flex;
    gap: 16px;
    justify-content: center;
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    transition-delay: 1.15s;
  }

  :global(html.js:not(.no-motion)) #hero:not(.is-powered) h1,
  :global(html.js:not(.no-motion)) #hero:not(.is-powered) .hero-lede,
  :global(html.js:not(.no-motion)) #hero:not(.is-powered) .cta-group {
    opacity: 0;
    transform: translateY(16px);
    transition-delay: 0s;
  }

  @media (max-width: 480px) {
    .cta-group {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      hero?.classList.add('is-powered');
    });
  });
</script>
