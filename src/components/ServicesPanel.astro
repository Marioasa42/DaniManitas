---
const services = [
  {
    icon: 'fa-toolbox',
    title: 'Reparaciones',
    copy: 'Arreglos generales, montajes y pequeñas reformas resueltos en el día.',
    variant: 'light',
  },
  {
    icon: 'fa-lightbulb',
    title: 'Iluminación',
    copy: 'De un punto de luz a un proyecto completo: diseño e instalación interior y exterior.',
    variant: 'dark',
    featured: true,
  },
  {
    icon: 'fa-hammer',
    title: 'Reformas',
    copy: 'Reformas parciales o integrales con acabados cuidados de principio a fin.',
    variant: 'light',
  },
];
---

<section id="servicios" class="services-section">
  <div class="container">
    <div class="services-grid">
      {services.map((s) => (
        <div class={`service-tile is-${s.variant} reveal`} class:list={{ 'is-featured': s.featured }}>
          <div class="service-icon"><i class={`fas ${s.icon}`}></i></div>
          <h3>{s.title}</h3>
          <p>{s.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    z-index: 2;
    margin-top: -60px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: 2px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-hover);
  }

  .service-tile {
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
  }

  .service-tile:nth-child(1) {
    transition-delay: 0s;
  }

  .service-tile:nth-child(2) {
    transition-delay: 0.12s;
  }

  .service-tile:nth-child(3) {
    transition-delay: 0.24s;
  }

  .service-tile.is-light {
    background: var(--paper);
    color: var(--ink);
  }

  .service-tile.is-dark {
    background: var(--graphite);
    color: var(--on-dark);
    padding-top: 52px;
    padding-bottom: 52px;
  }

  .service-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    margin-bottom: 18px;
    border-radius: 4px;
  }

  .is-light .service-icon {
    color: var(--signal);
    border: 1px solid rgba(18, 21, 26, 0.14);
  }

  .is-dark .service-icon {
    color: var(--graphite);
    background: var(--signal);
    box-shadow: 0 0 20px 1px var(--signal-line);
  }

  .service-tile h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .is-dark h3 {
    font-size: 1.35rem;
  }

  .service-tile p {
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .is-light p {
    color: var(--muted);
  }

  .is-dark p {
    color: var(--muted-on-dark);
    max-width: 30ch;
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-tile.is-dark {
      order: -1;
      padding: 40px 30px;
    }
  }
</style>
