---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lede: string;
  images: ImageMetadata[];
  altPrefix: string;
  variant: 'spotlight' | 'pan';
  dark?: boolean;
}

const { id, eyebrow, title, lede, images, altPrefix, variant, dark = false } = Astro.props;
---

<section id={id} class={`portfolio-section ${dark ? 'is-dark' : 'is-light'}`}>
  <div class="container">
    <div class={`section-header reveal ${dark ? 'section-header--dark' : ''}`}>
      {eyebrow && (
        <p class={`eyebrow ${dark ? 'eyebrow--dark' : ''}`}><span class="tick"></span>{eyebrow}</p>
      )}
      <h2>{title}</h2>
      <p>{lede}</p>
    </div>

    {variant === 'spotlight' && (
      <div class="spotlight-grid" data-lightbox-group={id}>
        {images.map((img, i) => (
          <div class="gallery-item lightbox-item">
            <Image src={img} alt={`${altPrefix} ${i + 1}`} widths={[320, 480, 640]} sizes="(max-width: 640px) 90vw, 320px" loading="lazy" />
          </div>
        ))}
      </div>
    )}

    {variant === 'pan' && (
      <div class="pan-wrap" data-lightbox-group={id}>
        <div class="pan-track">
          {images.map((img, i) => (
            <figure class="pan-slide gallery-item lightbox-item">
              <Image src={img} alt={`${altPrefix} ${i + 1}`} widths={[420, 640, 880]} sizes="(max-width: 900px) 80vw, 420px" loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .portfolio-section {
    padding: 130px 0 100px;
  }

  .portfolio-section.is-light {
    background: var(--steel);
  }

  .portfolio-section.is-dark {
    background: var(--graphite);
  }

  /* Spotlight grid (Iluminación) */
  .spotlight-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .spotlight-grid::after {
    content: '';
    position: absolute;
    inset: -20px;
    pointer-events: none;
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 176, 21, 0.14), transparent 68%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  .spotlight-grid.is-active::after {
    opacity: 1;
  }

  .gallery-item {
    border-radius: 4px;
    overflow: hidden;
    background: var(--slate);
    aspect-ratio: 4 / 3;
    position: relative;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: box-shadow 0.3s ease;
  }

  .gallery-item:hover {
    box-shadow: var(--shadow-hover);
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.86);
    transition: transform 0.6s var(--ease-out), filter 0.4s ease;
  }

  .gallery-item:hover :global(img) {
    transform: scale(1.045);
    filter: brightness(1.02);
  }

  /* Horizontal pan (Reformas) */
  .pan-wrap {
    position: relative;
  }

  .pan-track {
    display: flex;
    align-items: center;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
  }

  .pan-track .pan-slide {
    flex: 0 0 min(420px, 78vw);
    scroll-snap-align: start;
  }

  @media (min-width: 900px) {
    .pan-wrap {
      min-height: 82vh;
      display: flex;
      align-items: center;
    }

    .pan-track {
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }
  }
</style>
